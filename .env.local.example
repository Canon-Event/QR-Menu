NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Brevo transactional email (verify the sender domain in Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=FlavorBox
CONTACT_NOTIFICATION_EMAIL=support@yourdomain.com



# Razorpay (for subscriptions)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Enable after configuring Supabase Phone Auth and an SMS provider.
LOYALTY_PHONE_AUTH_ENABLED=false

# Restaurant food payments. Server-only JSON, keyed by restaurant UUID.
# Each restaurant uses its own Razorpay merchant account. Do not reuse the
# subscription credentials above. Configure automatic capture and signed webhooks.
# POS_RAZORPAY_ACCOUNTS={"restaurant-uuid":{"keyId":"rzp_test_...","keySecret":"...","webhookSecret":"..."}}
POS_RAZORPAY_ACCOUNTS={}

# Optional separate server-only HMAC secret (32+ random characters) for table
# scan tokens and IP hashes. Defaults to SUPABASE_SERVICE_ROLE_KEY when omitted.
# TABLE_ACCESS_HASH_SECRET=
# Vercel's forwarded IP is trusted automatically. For another hosting proxy,
# set this ONLY when that proxy strips and overwrites the named header.
# Otherwise unknown IPs share a conservative rate bucket.
# TABLE_ACCESS_TRUSTED_IP_HEADER=x-forwarded-for

# Optional online menu-photo reader. Local PaddleOCR needs no Gemini key.
# Server only: never prefix this key with NEXT_PUBLIC_.
# Create/rotate the key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MENU_MODEL=gemini-3.5-flash-lite
# Free-tier availability and quota are controlled by the Google project.
# The application has no paid fallback; a billing-enabled project may still incur charges.

# Notification scheduler: invoke /api/notifications/jobs every minute with
# Authorization: Bearer CRON_SECRET. Generate a random secret of 32+ characters.
CRON_SECRET=
NOTIFICATION_WORKER_ORIGIN=http://localhost:3000
# Optional Web Push. All keys stay server-side; the API exposes only the public key.
# Generate with: pnpm exec web-push generate-vapid-keys --json
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
